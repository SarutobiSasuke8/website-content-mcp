{
  "name": "@sarutobi-sasuke/website-content-mcp",
  "version": "0.4.0",
  "description": "MCP server exposing website content in agent-readable structured form.",
  "license": "MIT",
  "homepage": "https://github.com/SarutobiSasuke8/website-content-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/website-content-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/website-content-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "website",
    "content",
    "markdown",
    "scraping"
  ],
  "bin": {
    "website-content-http": "dist/src/http.js",
    "website-content-stdio": "dist/src/stdio.js",
    "website-content-dogfood": "dist/scripts/dogfood.js"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "server.json",
    "docs",
    "deploy",
    "dogfood"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/http.ts",
    "dev:stdio": "node --env-file-if-exists=.env --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/http.js",
    "start:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "pack:check": "npm pack --dry-run",
    "smoke:mcp": "npx -y @modelcontextprotocol/inspector@2.1.0 --cli --config test/fixtures/mcp-smoke.json --server website-content --method tools/list",
    "dogfood": "npm run build && node dist/scripts/dogfood.js",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jsdom": "26.1.0",
    "turndown": "7.2.0",
    "undici": "7.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/express": "5.0.6",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.15",
    "@types/turndown": "5.0.5",
    "eslint": "10.8.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
