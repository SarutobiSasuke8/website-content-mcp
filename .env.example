# Required: the site whose content this server exposes.
SITE_BASE_URL=https://example.com

# Optional: sitemap location (defaults to <base>/sitemap.xml).
# SITE_SITEMAP_URL=https://example.com/sitemap.xml

# Optional: comma-separated fallback page list used when no sitemap is found.
# Entries may be absolute URLs or paths relative to SITE_BASE_URL.
# SITE_PAGES=/,/about,/docs

# Optional: extra hosts this server may fetch from. The base URL's host (and the
# sitemap's, if configured elsewhere) is always allowed. Everything else is
# refused, so a stray absolute URL cannot turn this into an open proxy.
# SITE_ALLOWED_HOSTS=docs.example.com,blog.example.com

# Optional: cache tuning. CACHE_MAX_ENTRIES=0 disables eviction (unbounded).
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Optional: fetch behavior (min interval enforces max ~1 req/sec).
FETCH_TIMEOUT_MS=10000
FETCH_MIN_INTERVAL_MS=1000
# Hard cap on a single response body, in bytes.
FETCH_MAX_BYTES=5000000
# Retries on 429/503, honouring Retry-After.
FETCH_MAX_RETRIES=1
# USER_AGENT=website-content-mcp/0.3

# Optional: HTTP transport bind (localhost by default).
HOST=127.0.0.1
PORT=3215

# Streamable HTTP is public read-only by default: content_refresh is omitted
# and content_get_page cannot force origin revalidation. Enable only behind an
# authenticated/restricted reverse proxy. Stdio always retains refresh tools.
HTTP_ALLOW_REFRESH=false

# Optional operator-controlled cache warm after the HTTP listener starts.
# Useful for anonymous deployments where content_refresh remains hidden.
STARTUP_REFRESH_LIMIT=0
