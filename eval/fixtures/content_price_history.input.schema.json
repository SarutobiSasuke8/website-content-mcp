{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "limit": {
      "default": 200,
      "description": "Most recent points to return.",
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "plan": {
      "description": "Only this plan, matched by name.",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "site": {
      "description": "Optional site (host or origin) from the operator's site allowlist. Defaults to the configured base site. Anything else is refused.",
      "maxLength": 253,
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "url"
  ],
  "type": "object"
}
